# Copy to .env for local configuration. Keep real credentials out of version control.
PROXY_PORT=8080
PROXY_HOST=127.0.0.1
ALLOW_REMOTE_BIND=false
OLLAMA_URL=http://host.docker.internal:11434
CHROMADB_URL=http://chromadb:8000
POSTGRES_USER=local_rag
POSTGRES_PASSWORD=local_rag
POSTGRES_DB=local_rag
DATABASE_URL=postgresql+asyncpg://local_rag:local_rag@postgres:5432/local_rag
DEFAULT_MODEL=qwen3-coder:30b
CURATOR_MODEL=qwen2.5-coder:1.5b
EMBEDDING_MODEL=nomic-embed-text:latest
# Initial conservative limits; verify local Ollama metadata before raising them.
# Override a field with e.g. MODEL_BUDGETS__QWEN3-CODER:30B__CONTEXT_TOKENS=16384.
MODEL_BUDGETS={"qwen3-coder:30b":{"context_tokens":8192,"output_tokens":2048,"safety_tokens":512},"qwen2.5-coder:1.5b":{"context_tokens":8192,"output_tokens":2048,"safety_tokens":512},"qwen2.5-coder:7b":{"context_tokens":8192,"output_tokens":2048,"safety_tokens":512},"llama3.1:8b":{"context_tokens":8192,"output_tokens":2048,"safety_tokens":512},"qwen2.5:7b":{"context_tokens":8192,"output_tokens":2048,"safety_tokens":512}}
MEMORY_TOKEN_BUDGET=1024
RETRIEVAL_CANDIDATE_LIMIT=20
RETRIEVAL_RESULT_LIMIT=6
RETRIEVAL_MIN_SCORE=0.35
# Components are normalized to [0,1]; positive weights are normalized by their sum.
RANKING_WEIGHTS={"semantic":0.55,"importance":0.15,"recency":0.1,"overlap":0.15,"diversity":0.05,"recency_half_life_days":30}
RETRY_MAX_ATTEMPTS=5
RETRY_INITIAL_SECONDS=2
RETRY_MAX_SECONDS=300
UPSTREAM_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
