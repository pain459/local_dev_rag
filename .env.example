# Copy to .env for local configuration. Keep real credentials out of version control.
PROXY_PORT=8080
PROXY_HOST=127.0.0.1
ALLOW_REMOTE_BIND=false
OLLAMA_URL=http://host.docker.internal:11434
CHROMADB_URL=http://chromadb:8000
POSTGRES_USER=local_rag
POSTGRES_PASSWORD=local_rag
POSTGRES_DB=local_rag
# Leave blank to construct/encode from POSTGRES_* consistently in both apps.
# Optional override must encode reserved password characters (e.g. @ -> %40, : -> %3A).
DATABASE_URL=
DEFAULT_MODEL=qwen3-coder:30b
CURATOR_MODEL=qwen2.5-coder:1.5b
EMBEDDING_MODEL=nomic-embed-text:latest
# Practical 64K/32K limits; configure and verify matching Ollama runtime contexts.
# Keep overrides synchronized with opencode.json context/output declarations.
MODEL_BUDGETS={"qwen3-coder:30b":{"context_tokens":65536,"output_tokens":8192,"safety_tokens":4096},"qwen2.5-coder:1.5b":{"context_tokens":32768,"output_tokens":4096,"safety_tokens":2048},"qwen2.5-coder:7b":{"context_tokens":32768,"output_tokens":4096,"safety_tokens":2048},"llama3.1:8b":{"context_tokens":65536,"output_tokens":8192,"safety_tokens":4096},"qwen2.5:7b":{"context_tokens":32768,"output_tokens":4096,"safety_tokens":2048}}
MEMORY_TOKEN_BUDGET=1024
RETRIEVAL_CANDIDATE_LIMIT=20
RETRIEVAL_RESULT_LIMIT=6
RETRIEVAL_MIN_SCORE=0.35
# Components are normalized to [0,1]; positive weights are normalized by their sum.
# A candidate must meet the raw cosine similarity floor or share exact query tokens.
# This eligibility check runs before recency, importance, and diversity bonuses.
RANKING_WEIGHTS={"semantic":0.55,"importance":0.15,"recency":0.1,"overlap":0.15,"diversity":0.05,"recency_half_life_days":30,"min_semantic_similarity":0.2}
RETRY_MAX_ATTEMPTS=5
RETRY_INITIAL_SECONDS=2
RETRY_MAX_SECONDS=300
UPSTREAM_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
